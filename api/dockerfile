# https://hub.docker.com/_/python
# Build stage - compile dependencies
FROM python:3.11-slim-bookworm AS builder

ENV PYTHONUNBUFFERED=True
WORKDIR /build

# Install build dependencies required for sqlalchemy-libsql (Rust compilation)
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    gcc \
    cmake \
    && rm -rf /var/lib/apt/lists/*

# Install Rust (required for sqlalchemy-libsql)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Copy requirements and install to a specific directory
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# Runtime stage - minimal image
FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=True
ENV APP_HOME=/api
WORKDIR $APP_HOME

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application code
COPY . ./

# Create non-root user and switch to it
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser $APP_HOME
USER appuser

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080"]
